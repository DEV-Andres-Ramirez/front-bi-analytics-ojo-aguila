# OJO DE ÁGUILA — plantilla de variables de entorno (copiar a .env)

# PostgreSQL. Codificar caracteres especiales de la contraseña (p. ej. $ → %24). Sin "sslmode".
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:PUERTO/db_historico_territorial
DATABASE_SSL=true
DATABASE_POOL_MAX=5
# Opcional: PEM de la CA del servidor (RDS: bundle de la región en https://truststore.pki.rds.amazonaws.com).
# Si se define, el TLS verifica el certificado y el host de DATABASE_URL debe ser el endpoint DNS de RDS, no una IP.
# Admite el PEM en varias líneas entre comillas o en una línea con saltos escritos como \n.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Token único de acceso. Recomendado: un valor largo y aleatorio (openssl rand -base64 32).
# El login bloquea 5 minutos una IP tras 5 intentos fallidos (por instancia del servidor).
ACCESS_TOKEN=
# Secreto para firmar la sesión (openssl rand -base64 32)
AUTH_SECRET=
SESSION_TTL_HOURS=12
